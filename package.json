{
  "name": "chatstudio",
  "version": "0.2.1",
  "private": true,
  "license": "Apache-2.0",
  "description": "A local-first desktop building energy modeling assistant.",
  "author": {
    "name": "ChatStudio contributors",
    "email": "7058736+luzechao@users.noreply.github.com"
  },
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc -p tsconfig.main.json && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "setup:native": "node scripts/setup-native.mjs",
    "setup:bundle": "node scripts/setup-bundle.mjs",
    "test:native": "tsx --test tests/native.integration.ts",
    "test:desktop": "node --test tests/desktop.integration.mjs",
    "test:viewers": "tsx --test tests/viewer.native.ts && node --test tests/viewer.integration.mjs",
    "test:provider": "node --test --test-concurrency=1 tests/provider.integration.mjs tests/credentials.integration.mjs",
    "package": "npm run build && electron-builder --publish never",
    "package:native": "npm run setup:bundle && npm run build && electron-builder --config electron-builder.native.yml --publish never",
    "test:bundle": "tsx --test tests/bundle.integration.ts",
    "test:relocated": "node scripts/test-relocated-bundle.mjs",
    "test:package": "node --test tests/package.integration.mjs",
    "start": "electron ."
  },
  "dependencies": {
    "@carderne/sandbox-runtime": "0.0.77",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "three": "0.180.0",
    "typebox": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.180.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "playwright": "1.61.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "overrides": {
    "undici": "8.12.3",
    "zod": "4.6.7"
  }
}
